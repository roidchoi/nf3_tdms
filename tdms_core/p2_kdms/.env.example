# --- Layer A (EnvDetector 전용) ---
TDMS_ENV=dev
DEV_HOSTNAME=your-dev-pc
SERVER_HOSTNAME=your-server-pc
DEV_IP=192.168.x.x
SERVER_IP=192.168.x.y

# DEV KDMS DB
DEV_KDMS_DB_USER=roid
DEV_KDMS_DB_PASSWORD=
DEV_KDMS_DB_PORT=5432
DEV_KDMS_DB_NAME=kdms_db

# SERVER KDMS DB
SERVER_KDMS_DB_USER=roid
SERVER_KDMS_DB_PASSWORD=
SERVER_KDMS_DB_PORT=5432
SERVER_KDMS_DB_NAME=kdms_db

# --- Layer B (Docker / FastAPI 전용) ---
POSTGRES_USER=roid
POSTGRES_PASSWORD=yourpassword
DB_POOL_MIN=5
DB_POOL_MAX=20
LOG_LEVEL=INFO
